<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================
         SPEAK SMART BAGUIO — DARK APPLICATION THEME
         ===================================================== -->

    <style name="Theme.SpeakSmartBaguio"
        parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Brand colors -->
        <item name="colorPrimary">@color/cyan_primary</item>
        <item name="colorPrimaryVariant">@color/cyan_deep</item>
        <item name="colorOnPrimary">@color/text_on_cyan</item>

        <item name="colorSecondary">@color/cyan_secondary</item>
        <item name="colorSecondaryVariant">@color/cyan_deep</item>
        <item name="colorOnSecondary">@color/text_on_cyan</item>

        <!-- Dark backgrounds and surfaces -->
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/app_background</item>

        <!-- Global Default Font (Inter) -->
        <item name="android:fontFamily">@font/font_body</item>
        <item name="fontFamily">@font/font_body</item>

        <!-- Widget accents -->
        <item name="colorAccent">@color/cyan_primary</item>
        <item name="android:colorAccent">@color/cyan_primary</item>
        <item name="colorControlActivated">@color/cyan_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlHighlight">@color/cyan_secondary</item>

        <!-- Input field styling -->
        <item name="textInputStyle">@style/Widget.SpeakSmartBaguio.TextInputLayout</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.SpeakSmartBaguio.AutoCompleteTextView</item>

        <!-- Dialogs and popups -->
        <item name="android:colorBackgroundFloating">@color/app_surface_elevated</item>
        <item name="android:windowActionModeOverlay">true</item>

        <!-- Progress indicator -->
        <item name="android:progressBarStyle">@style/Widget.SpeakSmartBaguio.ProgressBar</item>

        <!-- System bars: light icons on dark backgrounds -->
        <item name="android:statusBarColor">@color/status_bar_color</item>
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Text appearance -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_disabled</item>

    </style>

    <!-- =====================================================
         TEXT INPUT LAYOUT
         ===================================================== -->

    <style name="Widget.SpeakSmartBaguio.TextInputLayout"
        parent="Widget.MaterialComponents.TextInputLayout.FilledBox">

        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxStrokeColor">@color/input_stroke_focused</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/font_body</item>
        <item name="fontFamily">@font/font_body</item>

    </style>

    <!-- =====================================================
         AUTO COMPLETE TEXT VIEW
         ===================================================== -->

    <style name="Widget.SpeakSmartBaguio.AutoCompleteTextView"
        parent="Widget.AppCompat.AutoCompleteTextView">

        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:colorAccent">@color/cyan_primary</item>
        <item name="android:popupBackground">@color/app_surface_elevated</item>
        <item name="android:backgroundTint">@color/cyan_primary</item>
        <item name="android:fontFamily">@font/font_body</item>
        <item name="fontFamily">@font/font_body</item>

    </style>

    <!-- =====================================================
         CYAN PROGRESS INDICATOR
         ===================================================== -->

    <style name="Widget.SpeakSmartBaguio.ProgressBar"
        parent="Widget.AppCompat.ProgressBar.Horizontal">

        <item name="android:indeterminateTint">@color/cyan_primary</item>
        <item name="android:progressTint">@color/cyan_primary</item>
        <item name="android:progressBackgroundTint">@color/divider_color</item>

    </style>

</resources>