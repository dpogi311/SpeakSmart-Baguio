<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".SplashActivity">

    <!-- APP LOGO -->

    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="88dp"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Speak Smart Baguio Logo"
        android:alpha="0"
        android:scaleX="0.8"
        android:scaleY="0.8" />

    <!-- APP TITLE -->

    <TextView
        android:id="@+id/textAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/splashLogo"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="SPEAK SMART BAGUIO"
        android:textColor="@color/cyan_primary"
        android:textSize="23sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:letterSpacing="0.04"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- DEVELOPER CREDIT -->

    <TextView
        android:id="@+id/textDeveloperCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textAppTitle"
        android:layout_marginTop="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="PROJECT"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans"
        android:letterSpacing="0.12"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- ANIMATED BIFROST TITLE -->

    <LinearLayout
        android:id="@+id/letterContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_below="@id/textDeveloperCredit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="22dp" />

    <!-- MAIN TAGLINE -->

    <TextView
        android:id="@+id/textGroupSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/letterContainer"
        android:layout_marginTop="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="LEARN  •  UNDERSTAND  •  CONNECT"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:letterSpacing="0.10"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- SECONDARY BIFROST TAGLINE -->

    <TextView
        android:id="@+id/textBifrostSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textGroupSub"
        android:layout_marginTop="13dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="BRIDGING LANGUAGES &amp; CONNECTING CULTURES"
        android:textColor="#8298B2"
        android:textSize="9sp"
        android:textStyle="normal"
        android:fontFamily="sans"
        android:letterSpacing="0.08"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- CUSTOM BIFROST LOADING ANIMATION -->

    <com.example.speaksmartbaguio.BifrostLoaderView
        android:id="@+id/bifrostLoader"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="82dp"
        android:alpha="0" />

</RelativeLayout>
