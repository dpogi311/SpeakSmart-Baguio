<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".SplashActivity">

    <!-- LOGO -->
    <ImageView
        android:id="@+id/splashLogo"
        android:layout_width="148dp"
        android:layout_height="148dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="76dp"
        android:src="@drawable/ic_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Speak Smart Baguio Logo"
        android:alpha="0"
        android:scaleX="0.8"
        android:scaleY="0.8" />

    <!-- APP NAME (Poppins Display) -->
    <TextView
        android:id="@+id/textAppTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/splashLogo"
        android:layout_marginTop="13dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="SPEAK SMART&#10;BAGUIO"
        android:textColor="@color/text_primary"
        android:textSize="29sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display"
        android:letterSpacing="0.06"
        android:lineSpacingExtra="1dp"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- DEVELOPER CREDIT (Space Grotesk Label) -->
    <TextView
        android:id="@+id/textDeveloperCredit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textAppTitle"
        android:layout_marginTop="17dp"
        android:gravity="center"
        android:text="DEVELOPED BY"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.24"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- TEAM NAME -->
    <LinearLayout
        android:id="@+id/letterContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_below="@id/textDeveloperCredit"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="19dp" />

    <!-- MAIN TAGLINE (Space Grotesk Label) -->
    <TextView
        android:id="@+id/textGroupSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/letterContainer"
        android:layout_marginTop="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:text="LEARN  •  UNDERSTAND  •  CONNECT"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.11"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- SECONDARY TAGLINE (Inter Body) -->
    <TextView
        android:id="@+id/textBifrostSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textGroupSub"
        android:layout_marginTop="14dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:gravity="center"
        android:text="BRIDGING LANGUAGES&#10;&amp; CONNECTING CULTURES"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp"
        android:textStyle="normal"
        android:fontFamily="@font/font_body"
        android:letterSpacing="0.07"
        android:lineSpacingExtra="4dp"
        android:includeFontPadding="false"
        android:alpha="0" />

    <!-- LOADING ANIMATION -->
    <com.example.speaksmartbaguio.BifrostLoaderView
        android:id="@+id/bifrostLoader"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="75dp"
        android:alpha="0" />

</RelativeLayout>