<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guidePageFive"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- PRONUNCIATION ILLUSTRATION CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:cardBackgroundColor="#0D1C21"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeColor="#1D4049"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivPronunciationIllustration"
                android:layout_width="210dp"
                android:layout_height="140dp"
                android:contentDescription="Pronunciation Illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/pronunciation_illustration" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/font_label"
                android:letterSpacing="0.14"
                android:text="LISTEN  •  SPEAK  •  LEARN"
                android:textColor="#E2F1F3"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- PAGE LABEL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.14"
        android:text="HEAR THE WORDS"
        android:textColor="#08D4C2"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- PAGE TITLE -->
    <TextView
        android:id="@+id/tvGuideTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/font_display"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Listen and Learn Pronunciation"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- PAGE DESCRIPTION -->
    <TextView
        android:id="@+id/tvGuideDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/font_body"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Listen to words and phrases spoken aloud using text-to-speech. Practice pronunciation and become more familiar with Benguet Ilokano."
        android:textColor="#9BB4B8"
        android:textSize="15sp" />

</LinearLayout>