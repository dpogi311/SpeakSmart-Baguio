<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/buttonAccessibilityBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/cyan_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="READABILITY &amp; ACCESS"
                android:textColor="@color/cyan_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_label"
                android:letterSpacing="0.16" />

        </LinearLayout>

        <!-- HEADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/app_surface_elevated"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/accessibilitySettingsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Accessibility Settings"
                    android:textColor="@color/cyan_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Customize text size, contrast, and layout to make Speak Smart Baguio comfortable to read."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TEXT SIZE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TYPOGRAPHY"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Text Size"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="Choose the size that is most comfortable for you."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_body" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider_color"
                    android:importantForAccessibility="no" />

                <RadioGroup
                    android:id="@+id/fontSizeRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/fontSizeStandard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="Standard"
                        android:fontFamily="@font/font_body"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:buttonTint="@color/cyan_primary" />

                    <RadioButton
                        android:id="@+id/fontSizeLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="Large"
                        android:fontFamily="@font/font_body"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:buttonTint="@color/cyan_primary" />

                    <RadioButton
                        android:id="@+id/fontSizeExtraLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="Extra Large"
                        android:fontFamily="@font/font_body"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:buttonTint="@color/cyan_primary" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- HIGH CONTRAST CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISUAL CLARITY"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="High Contrast"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Use clearer text and stronger visual contrast."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider_color"
                    android:importantForAccessibility="no" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHighContrast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Enable high contrast"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:thumbTint="@color/cyan_primary"
                    app:trackTint="@color/cyan_deep" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SIMPLIFIED LAYOUT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_cyan"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOCUS MODE"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Simplified Layout"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:accessibilityHeading="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reduce decorative elements to make important information easier to focus on."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="3dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:background="@color/divider_color"
                    android:importantForAccessibility="no" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSimplifiedLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Enable simplified layout"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_body"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    app:thumbTint="@color/cyan_primary"
                    app:trackTint="@color/cyan_deep" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RESET BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonResetAccessibility"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Reset to Default"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:textColor="@color/cyan_primary"
            android:backgroundTint="@color/app_surface"
            android:contentDescription="Reset all accessibility settings to their default values"
            app:cornerRadius="999dp"
            app:strokeColor="@color/cyan_deep"
            app:strokeWidth="1.5dp" />

    </LinearLayout>

</ScrollView>