<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/translatorScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    tools:context=".TranslatorFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- PAGE HEADER AND SETTINGS BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/translatorPageHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRANSLATOR"
                android:textColor="@color/cyan_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_label"
                android:letterSpacing="0.16" />

            <ImageButton
                android:id="@+id/buttonSettingsMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings_teal"
                android:contentDescription="Open settings menu"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:clickable="true"
                android:focusable="true"
                android:importantForAccessibility="yes"
                app:tint="@color/cyan_primary" />
        </LinearLayout>

        <!-- TRANSLATION TITLE -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="English → Ilokano"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/translatorSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Translate words and discover their meaning."
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="@font/font_body"
            android:lineSpacingExtra="3dp" />

        <!-- LANGUAGE SELECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="TRANSLATION MODE"
            android:textColor="@color/cyan_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.12" />

        <!-- LANGUAGE DROPDOWN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/languageDropdownLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@color/app_surface"
            app:boxStrokeColor="@color/dropdown_underline_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:hintEnabled="false"
            app:endIconMode="dropdown_menu"
            app:endIconTint="@color/cyan_primary">

            <AutoCompleteTextView
                android:id="@+id/languageDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/font_body"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- INPUT SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp"
            android:text="ENTER TEXT"
            android:textColor="@color/cyan_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.12" />

        <!-- INPUT FIELD -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputTextLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tap here and type a word"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="@color/app_surface"
            app:boxStrokeColor="@color/dropdown_underline_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"
            app:endIconMode="clear_text"
            app:endIconTint="@color/text_secondary"
            app:hintTextColor="@color/cyan_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:gravity="top|start"
                android:background="@android:color/transparent"
                android:textCursorDrawable="@drawable/cursor_cyan"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="30dp"
                android:paddingBottom="18dp"
                android:inputType="textCapSentences|textMultiLine"
                android:imeOptions="flagNoExtractUi"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:fontFamily="@font/font_body"
                android:lineSpacingExtra="4dp"
                android:autofillHints="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ENTER / TRANSLATE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTranslateEnter"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:minWidth="136dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:enabled="false"
            android:fontFamily="@font/font_display"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@color/text_disabled"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/divider_color"
            app:cornerRadius="14dp"
            app:elevation="2dp" />

        <!-- VOICE TOOLS HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="VOICE TOOLS"
            android:textColor="@color/cyan_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.12" />

        <!-- VOICE ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- MICROPHONE BUTTON -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    app:cardBackgroundColor="@color/cyan_primary"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/micButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp"
                        android:contentDescription="Start voice input"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/text_on_cyan" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Speak"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Voice input"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_body" />
            </LinearLayout>

            <!-- LISTEN BUTTON -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    app:cardBackgroundColor="@color/cyan_primary"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ttsButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="22dp"
                        android:contentDescription="Play translated text"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_sound"
                        app:tint="@color/text_on_cyan" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Listen"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Hear translation"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/font_body" />
            </LinearLayout>
        </LinearLayout>


        <!-- ORIGINAL TEXT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOriginalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/dropdown_underline_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@color/cyan_secondary" />

                    <TextView
                        android:id="@+id/originalTextLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:minHeight="22dp"
                        android:gravity="center_vertical"
                        android:text="Original Text"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_label"
                        android:letterSpacing="0.06"
                        android:accessibilityLiveRegion="polite" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/dropdown_underline_color" />

                <TextView
                    android:id="@+id/originalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- TRANSLATED TEXT CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTranslatedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/cyan_primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@color/cyan_primary" />

                    <TextView
                        android:id="@+id/translatedTextLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:minHeight="22dp"
                        android:gravity="center_vertical"
                        android:text="Translated Text (Results)"
                        android:textColor="@color/cyan_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_label"
                        android:letterSpacing="0.06"
                        android:accessibilityLiveRegion="polite" />

                    <TextView
                        android:id="@+id/btnCopyTranslation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/dropdown_glass_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/font_label"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Copy"
                        android:textColor="@color/cyan_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/dropdown_underline_color" />

                <!-- LOADING INDICATOR -->
                <LinearLayout
                    android:id="@+id/translationLoadingLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/cyan_primary" />

                    <TextView
                        android:id="@+id/tvTranslationLoading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Finding translation &amp; suggestions..."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/font_body" />

                </LinearLayout>

                <TextView
                    android:id="@+id/translatedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

                <!-- NO EXACT MATCH BANNER -->
                <LinearLayout
                    android:id="@+id/noMatchBannerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_search_modern"
                        app:tint="@color/cyan_primary"
                        android:contentDescription="Search indicator" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No exact match found"
                            android:textColor="@color/cyan_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="We couldn't find a direct translation for your input."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:fontFamily="@font/font_body" />

                    </LinearLayout>

                </LinearLayout>

                <!-- DID YOU MEAN HEADER -->
                <LinearLayout
                    android:id="@+id/didYouMeanHeaderLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_teal_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="DID YOU MEAN?"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label"
                            android:letterSpacing="0.10" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tap a suggestion below to use its translation:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/font_body" />

                </LinearLayout>

                <!-- NO TRANSLATION FOUND EMPTY STATE -->
                <LinearLayout
                    android:id="@+id/noTranslationFoundLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="22dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/dropdown_glass_background"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_search_modern"
                        app:tint="@color/cyan_primary"
                        android:contentDescription="No translation found" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="No Translation Found"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_display" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="We couldn't find an exact match or similar suggestions. Try checking your spelling or selecting another language."
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="@font/font_body"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/suggestionContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- HOME SCREEN FOOTER -->
        <include
            layout="@layout/view_app_footer" />

    </LinearLayout>
</ScrollView>