<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- DRAG HANDLE -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_teal_accent" />

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUGGESTION DETAILS"
            android:textColor="@color/cyan_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.10" />

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Full Description"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display" />

    </LinearLayout>

    <!-- SCROLLABLE DETAIL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- MAIN ILOKANO WORD/PHRASE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_cyan"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSheetTypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ILOKANO"
                        android:textColor="@color/cyan_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_label"
                        android:letterSpacing="0.10" />

                    <!-- WORD AND SPEAKER -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSheetIlokano"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/cyan_primary"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_display"
                            android:breakStrategy="high_quality" />

                        <ImageButton
                            android:id="@+id/btnSheetSpeak"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_speaker_button"
                            android:contentDescription="Listen to pronunciation"
                            android:padding="12dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_sound"
                            app:tint="@color/cyan_deep" />

                    </LinearLayout>

                    <!-- BADGES ROW -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSheetPos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/dropdown_glass_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label" />

                        <TextView
                            android:id="@+id/tvSheetCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/dropdown_glass_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ENGLISH TRANSLATION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dropdown_underline_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_teal_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="ENGLISH TRANSLATION"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSheetEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="@font/font_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- TAGALOG TRANSLATION CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dropdown_underline_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_teal_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="TAGALOG TRANSLATION"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSheetTagalog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:fontFamily="@font/font_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- DEFINITION / EXAMPLE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSheetDefinition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/app_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dropdown_underline_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_teal_accent" />

                        <TextView
                            android:id="@+id/tvSheetDefinitionHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="DEFINITION"
                            android:textColor="@color/cyan_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/font_label"
                            android:letterSpacing="0.08" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSheetDefinition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:fontFamily="@font/font_body"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM ACTION BUTTONS: BACK & USE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetBackAction"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="← Back"
            android:textAllCaps="false"
            android:fontFamily="@font/font_body"
            android:textColor="@color/cyan_primary"
            app:strokeColor="@color/cyan_deep"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetUseAction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.3"
            android:layout_marginStart="10dp"
            android:text="Use Word ✓"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:textColor="@color/text_on_cyan"
            app:backgroundTint="@color/cyan_primary"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
