<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- TOP BAR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPEAK SMART BAGUIO"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.10" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Phrase Details"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_display" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Go back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/cyan_primary" />

        </LinearLayout>


        <!-- MAIN ILOKANO PHRASE CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ILOKANO PHRASE"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.12" />

                <!-- MAIN ILOKANO PHRASE AND SPEAKER BUTTON -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvIlokano"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:paddingEnd="8dp"
                        android:textColor="@color/cyan_primary"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_display"
                        android:lineSpacingExtra="5dp"
                        android:breakStrategy="high_quality"
                        android:hyphenationFrequency="none"
                        android:textIsSelectable="true" />

                    <ImageButton
                        android:id="@+id/btnSpeakPhrase"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_speaker_button"
                        android:contentDescription="Listen to Ilokano phrase"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sound"
                        android:clickable="true"
                        android:focusable="true"
                        android:stateListAnimator="@null"
                        android:tooltipText="Listen to pronunciation"
                        app:tint="@color/cyan_primary" />

                </LinearLayout>

                <!-- DIVIDER -->

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/dropdown_underline_color" />

                <!-- PART OF SPEECH -->

                <TextView
                    android:id="@+id/tvPartOfSpeech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label" />

                <!-- CATEGORY -->

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/dropdown_glass_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- TRANSLATIONS HEADING -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Translations"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Understand the phrase in your preferred language."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/font_body"
            android:lineSpacingExtra="3dp" />


        <!-- ENGLISH TRANSLATION CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_deep"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ENGLISH HEADING -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_teal_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="ENGLISH"
                        android:textColor="@color/cyan_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_label"
                        android:letterSpacing="0.12" />

                </LinearLayout>

                <!-- ENGLISH TRANSLATION -->

                <TextView
                    android:id="@+id/tvEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- TAGALOG TRANSLATION CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_deep"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TAGALOG HEADING -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_teal_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="TAGALOG"
                        android:textColor="@color/cyan_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/font_label"
                        android:letterSpacing="0.12" />

                </LinearLayout>

                <!-- TAGALOG TRANSLATION -->

                <TextView
                    android:id="@+id/tvTagalog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- EXAMPLE SENTENCES HEADING -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Other Example Sentences"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="See how the phrase can be used in conversation."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/font_body"
            android:lineSpacingExtra="3dp" />


        <!-- ILOKANO EXAMPLE SENTENCE -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_deep"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ILOKANO"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ENGLISH EXAMPLE TRANSLATION -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/cyan_deep"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENGLISH TRANSLATION"
                    android:textColor="@color/cyan_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/font_label"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvEnglishSentence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="@font/font_body"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- APP FOOTER -->

        <include
            layout="@layout/view_app_footer" />

    </LinearLayout>

</ScrollView>