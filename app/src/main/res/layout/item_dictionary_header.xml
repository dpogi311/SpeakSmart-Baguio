<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DICTIONARY"
            android:textColor="@color/cyan_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.18" />

        <ImageButton
            android:id="@+id/buttonSettingsMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_teal"
            android:contentDescription="Open settings menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/cyan_primary" />
    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find a Word"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Explore English and Tagalog meanings in Ilokano."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/font_body"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="20dp" />

    <!-- SEARCH -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search for a word..."
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:startIconDrawable="@drawable/ic_search_modern"
        app:startIconTint="@color/cyan_primary"
        app:hintTextColor="@color/cyan_primary"
        app:expandedHintEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:nextFocusDown="@id/searchBar"
            android:nextFocusForward="@id/searchBar"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="@font/font_body" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- LANGUAGE LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TRANSLATION LANGUAGE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.10"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="8dp" />

    <!-- LANGUAGE DROPDOWN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/languageDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeColor="@color/dropdown_underline_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/cyan_primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/languageDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:hint="Select Target Language"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:popupBackground="@drawable/dropdown_glass_background" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- CATEGORY LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CATEGORY"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.10"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp" />

    <!-- CATEGORY DROPDOWN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/categoryDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeColor="@color/dropdown_underline_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/cyan_primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/categoryDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:hint="Select Category"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:popupBackground="@drawable/dropdown_glass_background" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- SORT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDictionaryFilter"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:padding="0dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:contentDescription="Open dictionary sorting options"
        android:tooltipText="Sort dictionary"
        android:text=""
        android:backgroundTint="@android:color/transparent"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_filter_cyan"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconTint="@color/cyan_primary"
        app:iconPadding="0dp"
        app:strokeColor="@color/cyan_deep"
        app:strokeWidth="1dp"
        app:cornerRadius="14dp" />

    <!-- SORTING PANEL -->
    <LinearLayout
        android:id="@+id/dictionaryFilterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/app_surface"
        android:padding="14dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORT DICTIONARY"
            android:textColor="@color/cyan_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.10"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/sortOrderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioSortAZ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A–Z"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/cyan_primary"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioSortZA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Z–A"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/cyan_primary" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearDictionaryFilters"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textAllCaps="false"
                android:fontFamily="@font/font_body"
                android:textColor="@color/cyan_primary"
                app:strokeColor="@color/cyan_deep"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonApplyDictionaryFilters"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Apply"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_on_cyan"
                app:backgroundTint="@color/cyan_primary"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- SECTION HEADING -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:text="EXPLORE &amp; DISCOVER"
        android:textColor="@color/cyan_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.14" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dictionary Results"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search to discover word meanings and pronunciations."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/font_body"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="8dp" />

    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:text="No words found"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/font_body"
        android:visibility="gone" />

</LinearLayout>