<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- SCREEN TITLE AND SETTINGS BUTTON -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/textFavoritesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Favorites"
            android:textColor="@color/cyan_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display"
            android:accessibilityHeading="true" />

        <ImageButton
            android:id="@+id/buttonSettingsMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_teal"
            android:contentDescription="Open settings menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            app:tint="@color/cyan_primary" />

    </LinearLayout>

    <!-- SCREEN SUBTITLE -->

    <TextView
        android:id="@+id/textFavoritesSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:text="Your saved Ilokano words and phrases"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/font_body" />

    <!-- FILTER CHIPS -->

    <LinearLayout
        android:id="@+id/layoutFavoriteFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipFavoritesAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/dropdown_glass_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_label"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="All"
            android:textColor="@color/text_on_cyan"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipFavoritesWords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/dropdown_glass_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_label"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="Words"
            android:textColor="@color/cyan_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipFavoritesPhrases"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/dropdown_glass_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/font_label"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:text="Phrases"
            android:textColor="@color/cyan_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- FAVORITE COUNT -->

    <TextView
        android:id="@+id/textFavoritesCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="0 saved items"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.04" />

    <!-- EMPTY STATE -->

    <LinearLayout
        android:id="@+id/layoutFavoritesEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♡"
            android:textColor="@color/cyan_primary"
            android:textSize="64sp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="No favorites yet"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tap the heart on a dictionary word or phrase to save it here."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/font_body"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- SAVED ITEMS LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewFavorites"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:overScrollMode="ifContentScrolls"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- LOADING INDICATOR -->

    <ProgressBar
        android:id="@+id/progressFavorites"
        style="?android:attr/progressBarStyle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

</LinearLayout>