<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/guidePageFour"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- PHRASEBOOK ILLUSTRATION CARD -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="230dp"
        app:cardBackgroundColor="@color/app_surface"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_cyan"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/ivPhrasebookIllustration"
                android:layout_width="210dp"
                android:layout_height="140dp"
                android:contentDescription="Phrasebook Illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/phrasebook_illustration" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/font_label"
                android:letterSpacing="0.16"
                android:text="PHRASEBOOK"
                android:textColor="@color/cyan_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- PAGE LABEL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.14"
        android:text="EVERYDAY EXPRESSIONS"
        android:textColor="@color/cyan_secondary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- PAGE TITLE -->
    <TextView
        android:id="@+id/tvGuideTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/font_display"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Learn Everyday Expressions"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- PAGE DESCRIPTION -->
    <TextView
        android:id="@+id/tvGuideDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/font_body"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Explore useful Benguet Ilokano phrases for greetings, daily interactions, and common conversations. Make communicating easier wherever you go."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

</LinearLayout>