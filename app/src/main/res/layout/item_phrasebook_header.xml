<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <!-- PHRASEBOOK HEADER AND SETTINGS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/textViewPhrasebookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Practical Sentence-based PHRASEBOOK"
            android:textColor="@color/cyan_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:includeFontPadding="false" />

        <ImageButton
            android:id="@+id/buttonSettingsMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_teal"
            android:contentDescription="Open settings menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            app:tint="@color/cyan_primary" />

    </LinearLayout>

    <!-- PAGE HEADING -->
    <TextView
        android:id="@+id/textViewPhrasebookHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Speak with Confidence"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/textViewPhrasebookSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Discover useful everyday phrases in Ilokano."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp" />

    <!-- SEARCH FIELD -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/phrasebookSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Search phrases..."
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintTextColor="@color/cyan_primary"
        app:expandedHintEnabled="true"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/cyan_primary"
        app:endIconMode="clear_text"
        app:endIconTint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:imeOptions="actionSearch" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- TARGET LANGUAGE LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="TRANSLATION LANGUAGE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.10" />

    <!-- TARGET LANGUAGE DROPDOWN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/languageDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeColor="@color/dropdown_underline_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/cyan_primary">

        <AutoCompleteTextView
            android:id="@+id/languageDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:hint="Select Target Language"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- RESULTS SECTION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="EXPLORE &amp; LEARN"
        android:textColor="@color/cyan_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.14" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Useful Phrases"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Discover everyday expressions and learn how to communicate naturally in Ilokano."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

    <!-- EMPTY RESULTS MESSAGE -->
    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="24dp"
        android:background="@drawable/dropdown_glass_background"
        android:gravity="center"
        android:text="No phrases found"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

</LinearLayout>
