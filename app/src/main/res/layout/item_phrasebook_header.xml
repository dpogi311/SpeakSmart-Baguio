<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <!-- PHRASEBOOK HEADER AND SETTINGS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/textViewPhrasebookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PHRASEBOOK"
            android:textColor="@color/cyan_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.18"
            android:includeFontPadding="false" />

        <ImageButton
            android:id="@+id/buttonSettingsMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_teal"
            android:contentDescription="Open settings menu"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:clickable="true"
            android:focusable="true"
            android:importantForAccessibility="yes"
            app:tint="@color/cyan_primary" />

    </LinearLayout>

    <!-- PAGE HEADING -->
    <TextView
        android:id="@+id/textViewPhrasebookHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Speak with Confidence"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/textViewPhrasebookSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Discover useful everyday phrases in Ilokano."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="@font/font_body"
        android:lineSpacingExtra="3dp" />

    <!-- SEARCH FIELD -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/phrasebookSearchLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Search phrases..."
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintTextColor="@color/cyan_primary"
        app:expandedHintEnabled="true"
        app:startIconDrawable="@drawable/ic_search_modern"
        app:startIconTint="@color/cyan_primary"
        app:endIconMode="clear_text"
        app:endIconTint="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:fontFamily="@font/font_body"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:nextFocusDown="@id/searchBar"
            android:nextFocusForward="@id/searchBar" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- TARGET LANGUAGE LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="8dp"
        android:text="TRANSLATION LANGUAGE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.10" />

    <!-- TARGET LANGUAGE DROPDOWN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/languageDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeColor="@color/dropdown_underline_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/cyan_primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/languageDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:hint="Select Target Language"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:popupBackground="@drawable/dropdown_glass_background" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- CATEGORY FILTER LABEL -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="CATEGORY"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.10" />

    <!-- CATEGORY DROPDOWN -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/categoryDropdownLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/app_surface"
        app:boxStrokeColor="@color/dropdown_underline_color"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        app:hintEnabled="false"
        app:endIconMode="dropdown_menu"
        app:endIconTint="@color/cyan_primary">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/categoryDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@android:color/transparent"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp"
            android:hint="Select Category"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_body"
            android:inputType="none"
            android:focusable="false"
            android:clickable="true"
            android:popupBackground="@drawable/dropdown_glass_background" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- SORT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPhrasebookFilter"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:padding="0dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:contentDescription="Open phrasebook sorting options"
        android:tooltipText="Sort phrasebook"
        android:text=""
        android:backgroundTint="@android:color/transparent"
        android:stateListAnimator="@null"
        app:icon="@drawable/ic_filter_cyan"
        app:iconGravity="textStart"
        app:iconSize="24dp"
        app:iconTint="@color/cyan_primary"
        app:iconPadding="0dp"
        app:strokeColor="@color/cyan_deep"
        app:strokeWidth="1dp"
        app:cornerRadius="14dp" />

    <!-- SORTING PANEL -->
    <LinearLayout
        android:id="@+id/phrasebookFilterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/app_surface"
        android:padding="14dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SORT PHRASEBOOK"
            android:textColor="@color/cyan_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/font_label"
            android:letterSpacing="0.10"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/sortOrderGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioSortAZ"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A–Z"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/cyan_primary"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioSortZA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Z–A"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/cyan_primary" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClearPhrasebookFilters"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Reset"
                android:textAllCaps="false"
                android:fontFamily="@font/font_body"
                android:textColor="@color/cyan_primary"
                app:strokeColor="@color/cyan_deep"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonApplyPhrasebookFilters"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Apply"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:fontFamily="@font/font_body"
                android:textColor="@color/text_on_cyan"
                app:backgroundTint="@color/cyan_primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- RESULTS SECTION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="EXPLORE &amp; LEARN"
        android:textColor="@color/cyan_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_label"
        android:letterSpacing="0.14" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Useful Phrases"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/font_display" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Discover everyday expressions and learn how to communicate naturally in Ilokano."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="@font/font_body"
        android:lineSpacingExtra="2dp" />

    <!-- LOADING INDICATOR -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/cyan_primary"
        android:visibility="gone" />

    <!-- EMPTY RESULTS MESSAGE -->
    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="24dp"
        android:background="@drawable/dropdown_glass_background"
        android:gravity="center"
        android:text="No phrases found"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:fontFamily="@font/font_body"
        android:lineSpacingExtra="4dp"
        android:visibility="gone" />

</LinearLayout>